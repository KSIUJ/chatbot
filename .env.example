# Skopiuj do .env i uzupelnij. Puste = wartosc domyslna z kodu (podana w nawiasie).

# --- Logowanie przez Keycloak KSI (OIDC) - WYMAGANE, bez nich backend nie wystartuje ---
OIDC_ISSUER=https://auth.ksi.sh/realms/ksi
OIDC_CLIENT_ID=chatbot
# Sekret klienta od adminow KSI - nigdy nie commituj.
OIDC_CLIENT_SECRET=
# Musi byc w "Valid redirect URIs" klienta w Keycloaku. https => ciasteczka Secure.
#   Docker lokalnie: http://localhost:8080/api/auth/callback
#   npm run dev:     http://localhost:5173/api/auth/callback
#   Produkcja:       https://chat.ksi.sh/api/auth/callback
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/callback
# Klucz szyfrujacy tokeny i ciasteczka (min. 32 znaki); zmiana wylogowuje wszystkich.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# --- Logowanie - opcjonalne ---
# Wymagana grupa (pelna sciezka). (/Członek)
OIDC_REQUIRED_GROUP=
# Grupa adminow (pelna sciezka): panel administratora - limity, zgloszenia, incydenty,
# diagnostyka (/api/admin/*). off wylacza - nikt nie jest adminem. (/Zarząd)
OIDC_ADMIN_GROUP=
# Claim z grupami w userinfo. (groups)
OIDC_GROUPS_CLAIM=
# (openid profile email)
OIDC_SCOPES=
# Powrot po wylogowaniu, musi byc w "Valid post logout redirect URIs". (origin OIDC_REDIRECT_URI + /)
OIDC_POST_LOGOUT_REDIRECT_URI=
# Algorytmy podpisu ID tokenu po przecinku; HS* i none zabronione. (RS*, PS*, ES*, EdDSA)
OIDC_ID_TOKEN_ALGORITHMS=
# Timeout zapytan do Keycloaka w sekundach. (10)
OIDC_HTTP_TIMEOUT=
# Maksymalna dlugosc sesji w godzinach. (168)
AUTH_SESSION_MAX_AGE_HOURS=
# Dokad wrocic po zalogowaniu. (/)
AUTH_FRONTEND_URL=
# true/false. (wg schematu OIDC_REDIRECT_URI)
AUTH_COOKIE_SECURE=
# Dodatkowe dozwolone originy frontendu (CORS i naglowek Origin), po przecinku.
# Origin OIDC_REDIRECT_URI jest dozwolony zawsze. (http://localhost:5173)
FRONTEND_ORIGINS=

# --- Model jezykowy ---
# ollama | claude | openrouter | cursor. (ollama)
LLM_PROVIDER=ollama
# Ollama: adres, model, okno kontekstu. (http://localhost:11434, qwen2.5:14b, 8192)
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_NUM_CTX=
# Klucze i modele dostawcow API - wymagany tylko klucz wybranego dostawcy.
ANTHROPIC_API_KEY=
# (claude-sonnet-5)
CLAUDE_MODEL=
OPENROUTER_API_KEY=
# Format "dostawca/model". (google/gemini-2.5-flash)
OPENROUTER_MODEL=
# Cursor Cloud Agents - wolny (dziesiatki sekund na odpowiedz), tylko na demo.
CURSOR_API_KEY=
# (claude-haiku-4-5)
CURSOR_MODEL=

# --- Rozmowy ---
# Przepisywanie pytan doprecyzowujacych na samodzielne zapytanie przed
# wyszukiwaniem - tylko przy LLM_PROVIDER=ollama. off/0/false/no/nie wylacza. (on)
CHAT_CONDENSE=
# Ile ostatnich pytan uzytkownika bierze pod uwage. (5)
CHAT_CONDENSE_QUESTIONS=
# Ile wiadomosci historii trafia do promptu (0 wylacza) i limit znakow na wiadomosc. (4, 600)
CHAT_HISTORY_MESSAGES=
CHAT_HISTORY_CHAR_LIMIT=
# Historia w sidebarze: rozmow na konto, dni do usuniecia nieuzywanej rozmowy,
# co ile godzin sprawdzac wygasle. (10, 30, 6)
CHAT_HISTORY_MAX_PER_USER=
CHAT_HISTORY_RETENTION_DAYS=
CHAT_HISTORY_PURGE_INTERVAL_HOURS=

# --- Limity (wartosci domyslne; zarzad zmienia je w panelu administratora,
# zapisane tam wartosci maja pierwszenstwo) ---
# Pytania do modelu na osobe na dobe (do polnocy czasu polskiego), 1-1000. (10)
CHAT_DAILY_LIMIT=
# Zalaczniki - egzekwowane, gdy pojawi sie funkcja zalacznikow.
# Maks. rozmiar pliku w MB (1-50), plikow w wiadomosci (1-20), zalacznikow na osobe na dobe (0-500). (10, 5, 20)
ATTACHMENT_MAX_FILE_MB=
ATTACHMENT_MAX_FILES_PER_MESSAGE=
ATTACHMENT_DAILY_LIMIT=
# Dozwolone typy po przecinku: pdf, docx, txt, png, jpeg (jpg), webp. (wszystkie)
ATTACHMENT_ALLOWED_TYPES=

# --- RAG ---
# Model embeddingowy i prefiksy query/passage. (sdadas/mmlw-roberta-large, "zapytanie: ", "")
RAG_EMBEDDING_MODEL=
RAG_QUERY_PREFIX=
RAG_PASSAGE_PREFIX=
# cuda / mps / cpu. (wykrywane automatycznie)
RAG_DEVICE=

# --- Baza aplikacji (konta, rozmowy) --- (sqlite:///./chatbot.db; w Dockerze ustawia compose)
DATABASE_URL=

# --- Docker --- port frontendu na hoscie. (8080)
FRONTEND_PORT=

# --- Scrapery (pipeline/scrapers) ---
# Aplikacja USOS API: https://apps.usos.uj.edu.pl/developers/
USOS_CONSUMER_KEY=
USOS_CONSUMER_SECRET=
# Wypelnia pipeline/scrapers/usos/usos_login.py (potrzebne do scrape_staff.py --with-email).
USOS_ACCESS_TOKEN=
USOS_ACCESS_TOKEN_SECRET=
# Ciasteczko sesji Mordoru dla pipeline/scrapers/mordor/files_downloader.py.
MORDOR_COOKIE=

# USOS API UJ - dane aplikacji zarejestrowanej na https://apps.usos.uj.edu.pl/developers/
# Potrzebne dla wywolan podpisanych kluczem consumer (2-legged OAuth1, bez
# logowania uzytkownika) - patrz usos_call_signed() w src/data/usos/usos_api.py,
# uzywane przez scrape_staff.py oraz usos_client.py --signed. Tryb anonimowy
# (domyslny w usos_client.py) tego NIE wymaga. Pelny 3-legged flow
# (usos_call_authenticated() w usos_api.py) jest juz zaimplementowany i
# tez korzysta z tych samych kluczy - patrz USOS_ACCESS_TOKEN ponizej
# i src/data/usos/usos_login.py, ktory je uzupelnia.
USOS_CONSUMER_KEY=
USOS_CONSUMER_SECRET=

# Wypelniane automatycznie przez src/data/usos/usos_login.py po przejsciu
# jednorazowego logowania 3-legged OAuth1 - NIE wpisuj tu nic recznie.
# Wymagane przez usos_call_authenticated() i flage --with-email w
# scrape_staff.py.
USOS_ACCESS_TOKEN=
USOS_ACCESS_TOKEN_SECRET=

# RAG (src/backend/RAG/encoder.py) - opcjonalne, maja rozsadne wartosci
# domyslne w kodzie. Zmien tylko jesli chcesz podmienic model embeddingowy
# lub jego prefiksy query/passage (patrz komentarz w encoder.py).
RAG_EMBEDDING_MODEL=
RAG_QUERY_PREFIX=
RAG_PASSAGE_PREFIX=

# Wybor dostawcy LLM (src/backend/llm/generate.py) - "ollama" (domyslnie,
# lokalny model), "claude" (Claude API, src/backend/llm/claude_client.py)
# albo "cursor" (Cursor Cloud Agents API, src/backend/llm/cursor_client.py -
# UWAGA: wolne, provisioning VM na kazde zapytanie, tylko na demo/1 user).
LLM_PROVIDER=ollama

# Wymagane tylko gdy LLM_PROVIDER=claude. Klucz z konsoli Anthropic
# (https://console.anthropic.com/) - NIE commituj prawdziwego klucza.
ANTHROPIC_API_KEY=

# Opcjonalne - nadpisuje domyslny model Claude (claude-sonnet-5) uzywany przez
# claude_client.py.
CLAUDE_MODEL=

# Wymagane tylko gdy LLM_PROVIDER=cursor. Klucz z https://cursor.com/dashboard/api
# - NIE commituj prawdziwego klucza.
CURSOR_API_KEY=

# Opcjonalne - nadpisuje domyslny model Cursora (claude-haiku-4-5). Inne ID
# sprawdzisz przez cursor_client.list_models() (GET /v1/models).
CURSOR_MODEL=
